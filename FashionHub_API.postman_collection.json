          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/products?keyword=shirt&category=Clothing&minPrice=20&maxPrice=100",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "products"],
              "query": [
                {
                  "key": "keyword",
                  "value": "shirt"
                },
                {
                  "key": "category",
                  "value": "Clothing"
                },
                {
                  "key": "minPrice",
